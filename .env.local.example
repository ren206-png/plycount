# ── Supabase ──────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ── App ───────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Stripe (platform subscription billing — MVP: Starter/Growth tiers) ──
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_STARTER=
STRIPE_PRICE_GROWTH=

# ── Email (quote delivery) ────────────────────────────────
RESEND_API_KEY=
# Must be a verified sender on your Resend domain. Falls back to
# quotes@plycount.app (won't deliver) if unset.
RESEND_FROM_EMAIL=

# ── Accounting sync: QuickBooks Online ────────────────────
QUICKBOOKS_CLIENT_ID=
QUICKBOOKS_CLIENT_SECRET=
# Must exactly match a redirect URI registered on the Intuit app.
# Falls back to `${origin}/api/quickbooks/callback` if unset.
QUICKBOOKS_REDIRECT_URI=
# "sandbox" (default) or "production" — selects the QBO API host.
QUICKBOOKS_ENVIRONMENT=sandbox

# ── Accounting sync: Xero ─────────────────────────────────
# Only one accounting provider (QuickBooks or Xero) can be connected per
# organization at a time.
XERO_CLIENT_ID=
XERO_CLIENT_SECRET=
# Must exactly match a redirect URI registered on the Xero app.
# Falls back to `${origin}/api/xero/callback` if unset.
XERO_REDIRECT_URI=

# ── Monitoring: Sentry ────────────────────────────────────
# Runtime error monitoring (client, server, and edge — see
# sentry.*.config.ts). Optional: unset means Sentry.init() is
# never called and the app behaves exactly as it does today.
NEXT_PUBLIC_SENTRY_DSN=
# Org/project slug + auth token, only needed to upload source maps
# for readable stack traces in production build; error capture
# itself works without them once NEXT_PUBLIC_SENTRY_DSN is set.
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=

# ── Bot protection: Cloudflare Turnstile (CAPTCHA) ───────
# PUBLIC site key from the Cloudflare Turnstile widget. Optional: unset means
# no CAPTCHA widget is shown. The matching SECRET key does NOT go in this app;
# it is entered in Supabase (Authentication -> Attack Protection -> CAPTCHA
# protection -> Turnstile), which verifies every sign-in and sign-up.
# Order matters: set this key and deploy BEFORE enabling CAPTCHA in Supabase,
# otherwise sign-in is refused (the forms would send no token).
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
